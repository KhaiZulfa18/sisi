{
  "manifest_version": 3,
  "name": "Sisi — To-Do List",
  "description": "To-do list minimalis di side panel Chrome. Checklist, tag, dan riwayat tugas selesai.",
  "version": "1.4.0",
  "permissions": ["storage", "sidePanel"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Buka/tutup Sisi"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Buka To-Do List"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
